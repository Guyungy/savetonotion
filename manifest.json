{
   "action": {
      "default_title": "Use Save.to"
   },
   "background": {
      "service_worker": "serviceWorker.js"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Alt+Shift+E",
            "mac": "Alt+Shift+E"
         }
      },
      "add-highlights": {
         "description": "Add highlights to your Notion Page",
         "suggested_key": {
            "default": "Ctrl+Shift+E",
            "mac": "Command+Shift+E"
         }
      },
      "take-custom-area-screenshot": {
         "description": "Take custom area screenshot",
         "suggested_key": {
            "default": "Ctrl+Shift+A",
            "mac": "Command+Shift+A"
         }
      },
      "take-full-page-screenshot": {
         "description": "Take full page screenshot",
         "suggested_key": {
            "default": "Ctrl+Shift+S",
            "mac": "Command+Shift+S"
         }
      }
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self';"
   },
   "description": "Save the Web to Notion or Feishu · 中文界面与网站适配",
   "host_permissions": [
      "https://*.notion.so/*",
      "https://*.notion.com/*",
      "https://open.feishu.cn/*"
   ],
   "icons": {
      "128": "assets/icon128.png",
      "48": "assets/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Save.to - formerly Save to Notion",
   "optional_host_permissions": [
      "https://*.licdn.com/*",
      "<all_urls>"
   ],
   "optional_permissions": [
      "tabs",
      "webNavigation"
   ],
   "permissions": [
      "activeTab",
      "storage",
      "cookies",
      "scripting",
      "contextMenus",
      "unlimitedStorage"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.3.14",
   "web_accessible_resources": [
      {
         "matches": [
            "<all_urls>"
         ],
         "resources": [
            "popup/index.html",
            "modal/modal.html",
            "toast/toast.html",
            "highlightTooltip/highlightTooltip.html",
            "restricted_popup/index.html",
            "restricted_popup/script.js",
            "onboarding_guide_popup/index.html",
            "onboarding_guide_popup/script.js",
            "welcome/welcome.html",
            "assets/*.js",
            "stn-i18n/dict.js",
            "stn-i18n/engine.js",
            "stn-feishu/entry.js"
         ]
      }
   ],
   "options_page": "stn-feishu/index.html"
}
